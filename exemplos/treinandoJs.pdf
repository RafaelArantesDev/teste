const Notas = [
    { nome: "Ana", nota: 8 },
    { nome: "Carlos", nota: 5 },
    { nome: "João", nota: 10 },
    { nome: "Maria", nota: 8 },
    { nome: "Pedro", nota: 5 }
]


const NotaAlunos = Notas.reduce((acumulador, item) => {
   if (acumulador[item.nota] === undefined){
    acumulador[item.nota] = 1
   }else{
    acumulador[item.nota] = acumulador[item.nota] + 1
   }return acumulador
}, {})

console.log(NotaAlunos)



const produtos = [
    { id: 1, nome: "Mouse", preco: 50, estoque: 10 },
    { id: 2, nome: "Teclado", preco: 120, estoque: 5 },
    { id: 3, nome: "Monitor", preco: 900, estoque: 2 },
    { id: 4, nome: "Notebook", preco: 3500, estoque: 1 },
    { id: 5, nome: "Headset", preco: 22200, estoque: 0 }
]


const qtdEstoque = produtos.some((item) => {return item.estoque === 0})

console.log(`Existe algum produto com estoque em 0? - ${qtdEstoque}`)



const maisCaro = produtos.sort(  (a, b) => {return a.preco - b.preco})

const carooo = produtos.reduce(  (acumulador, item) => {
    if(acumulador.preco < item.preco){
        acumulador = item
    }return acumulador
})

console.log(carooo)

